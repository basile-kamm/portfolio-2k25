{
  "name": "eikon-parcel-starter",
  "version": "1.0.0",
  "description": "Web projects starterkit for eikon students",
  "scripts": {
    "clean:output": "rimraf dist",
    "clean:cache": "rimraf .parcel-cache",
    "dev": "NODE_ENV=development parcel src/index.html",
    "build": "npm run clean:output && NODE_ENV=production parcel build src/index.html --public-url '/' --no-cache"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:eikon-frontend/starterkit.git"
  },
  "author": "eikon frontend development team",
  "license": "ISC",
  "homepage": "https://github.com/eikon-frontend/starterkit",
  "parcel-namer-rewrite": {
    "rules": {
      "(.*)\\.(css)": "css/$1{.hash}.$2",
      "(.*)\\.(js)": "js/$1{.hash}.$2",
      "(.*)\\.(woff|woff2?)": "fonts/$1.$2",
      "(.*)\\.(mp3)": "audio/$1.$2",
      "(.*)\\.(mp4|ogg|webm)": "video/$1.$2",
      "(.*)\\.(svg|png|gif|jpg|webp)": "img/$1{.hash}.$2"
    },
    "silent": true,
    "development": {
      "disable": false
    }
  },
  "devDependencies": {
    "@parcel/transformer-sass": "^2.16.4",
    "parcel": "^2.16.4",
    "parcel-namer-rewrite": "^2.16.4",
    "posthtml-extend": "^0.6.5",
    "posthtml-include": "^2.0.1",
    "rimraf": "^6.1.4",
    "sass": "^1.108.2",
    "sharp": "^0.33.5"
  },
  "dependencies": {
    "bootstrap": "^5.3.9",
    "gsap": "^3.15.1",
    "posthtml-expressions": "^1.11.4"
  }
}
